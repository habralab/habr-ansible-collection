##
# {{ item.value['description'] }}
##
{% set _active_vars = q('varnames', item.value.triggers | join('|')) %}
{% if 'nginx_real_ip_set_from' in _active_vars %}

{% for _ip in lookup('vars', 'nginx_real_ip_set_from') %}
set_real_ip_from {{ _ip }};
{% endfor %}
{% endif %}
{% if 'nginx_real_ip_lists' in _active_vars and 'nginx_ip_sets' in q('varnames', '^nginx_ip_sets$') %}

{% set _ip_sets = lookup('vars', 'nginx_ip_sets') %}
{% for _list_name in lookup('vars', 'nginx_real_ip_lists') %}
{% if _list_name in _ip_sets %}
{% for _prefix in _ip_sets[_list_name] %}
set_real_ip_from {{ _prefix.net }}; # {{ _list_name }}{% if _prefix.remark is defined %} - {{ _prefix.remark }}{% endif %}{{ '' }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% if 'nginx_real_ip_header' in _active_vars %}

real_ip_header "{{ lookup('vars', 'nginx_real_ip_header') }}";
{% endif %}
{% if 'nginx_real_ip_recursive' in _active_vars %}

real_ip_recursive {{ lookup('vars', 'nginx_real_ip_recursive') | bool | ternary('on', 'off') }};
{% endif %}
