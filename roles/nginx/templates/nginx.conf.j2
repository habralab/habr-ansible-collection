user			{{ nginx_working_owner }};
worker_processes	{{ nginx_worker_processes | int }};

include			/etc/nginx/modules-enabled/*;
error_log		/var/log/nginx/error.log warn;
pid			/var/run/nginx.pid;

worker_rlimit_nofile	{{ nginx_worker_rlimit_nofile | int }};

events {
{% if nginx_use is defined %}
	use			{{ nginx_use }};
{% endif %}
	worker_connections	{{ nginx_worker_connections | int }};
	multi_accept		{% if nginx_multi_accept | default('false') | bool %}on{% else %}off{% endif %};
}


http {
	include			/etc/nginx/mime.types;
	default_type		application/octet-stream;

	log_format		main  '$remote_addr - $remote_user [$time_local] "$request" '
				'$status $body_bytes_sent "$http_referer" '
				'"$http_user_agent" "$http_x_forwarded_for" "$http_x_fronting_host"';

	access_log		off;

	server_name_in_redirect	off;
	server_tokens		off;
	sendfile		on;
	tcp_nopush		on;
	tcp_nodelay		on;
	keepalive_timeout	65;

	types_hash_max_size		{{ nginx_types_hash_max_size | int }};
	variables_hash_max_size		{{ nginx_variables_hash_max_size | int }};
	variables_hash_bucket_size	{{ nginx_variables_hash_bucket_size | int }};
	map_hash_max_size		{{ nginx_map_hash_max_size | int }};
	client_body_buffer_size		{{ nginx_client_body_buffer_size }};
	client_max_body_size		{{ nginx_client_max_body_size }};
	proxy_headers_hash_max_size	{{ nginx_proxy_headers_hash_max_size | int }};
	proxy_headers_hash_bucket_size	{{ nginx_proxy_headers_hash_bucket_size | int }};
	server_names_hash_max_size {{ nginx_server_names_hash_max_size | int }};
	server_names_hash_bucket_size {{ nginx_server_names_hash_bucket_size | int }};


	proxy_buffering			{% if nginx_proxy_buffering | bool %}on{% else %}off{% endif %};
	proxy_buffer_size		{{ nginx_proxy_buffer_size }};
	proxy_buffers			{{ nginx_proxy_buffers }};
	proxy_max_temp_file_size	{{ nginx_proxy_max_temp_file_size }};
{% if nginx_proxy_next_upstream is defined %}
	proxy_next_upstream		{{ nginx_proxy_next_upstream | join(' ') }};
{% endif %}
{% if nginx_proxy_next_upstream_timeout is defined %}
	proxy_next_upstream_timeout	{{ nginx_proxy_next_upstream_timeout | int }};
{% endif %}
{% if nginx_proxy_next_upstream_tries is defined %}
	proxy_next_upstream_tries	{{ nginx_proxy_next_upstream_tries | int }};
{% endif %}

	include			/etc/nginx/conf.d/*.conf;
{% if nginx_include_sites_enabled | bool %}
	include			/etc/nginx/sites-enabled/*;
{% endif %}
{% if nginx_include_dirs | length > 0 %}
{% for include in nginx_include_dirs %}
	include			{{ include }};
{% endfor %}
{% endif %}
}
